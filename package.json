{
  "name": "claw-chat",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first workspace for agent conversations, subagent trees, decision checkpoints, and project context.",
  "directories": {
    "doc": "docs"
  },
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/Palominoconsulting/claw-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Palominoconsulting/claw-chat.git"
  },
  "bugs": {
    "url": "https://github.com/Palominoconsulting/claw-chat/issues"
  },
  "keywords": [],
  "main": "index.js",
  "engines": {
    "node": ">=26.5.0 <27"
  },
  "scripts": {
    "dev": "npm run build && node dist/server/index.js",
    "start": "node dist/server/index.js",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@openclaw/gateway-client": "2026.8.1",
    "@openclaw/gateway-protocol": "2026.8.1",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@eslint-react/eslint-plugin": "5.19.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "ws": "8.21.3"
  }
}
